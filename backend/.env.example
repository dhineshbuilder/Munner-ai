# Supabase Configuration
# Obtain these from: Project Settings -> API in your Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Supabase JWT Secret (Required if you want the backend to verify JWT tokens locally)
# Obtain this from: Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
